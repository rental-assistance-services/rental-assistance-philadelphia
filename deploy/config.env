# deploy/config.env: the settings the Cloudflare Pages build and the site checks read.
# Plain assignments only (the workflow refuses to source anything else).

# Do the post-deploy and daily checks run? off until the Cloudflare Pages project
# is connected to this repository and has published main once; then on, in the
# same one-line pull request that confirms PAGES_URL below.
CHECKS=off

# The Cloudflare Pages project that serves this site (Abe's Cloudflare account).
PAGES_PROJECT=rental-assistance-services

# The project's own address. Always answers, before and after the domain moves.
# Cloudflare adds a suffix when the plain name is taken; confirm it after creation.
PAGES_URL=https://rental-assistance-services.pages.dev/

# The public address the checks hold to account. Empty until the domain points at
# Cloudflare Pages; then https://www.rentalassistanceservices.com/ (Cloudflare Pages
# can serve a bare domain only when its DNS is at Cloudflare; this DNS is at GoDaddy,
# which forwards the bare domain to www).
PUBLIC_URL=

# The origin every canonical link, og:url, sitemap entry and structured-data URL
# should name. The source files say https://rentalassistanceservices.com; the
# build rewrites them to this value when it differs. Change it in the same pull
# request that moves the public address to www.
CANONICAL_ORIGIN=https://rentalassistanceservices.com

# The branch Cloudflare publishes to production. Every other branch is a preview
# and gets X-Robots-Tag: noindex.
PRODUCTION_BRANCH=main
